TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Required for PLACE_ON_MAP. A vision model on the same endpoint and key.
MAP_MODEL=google/gemini-3.8-flash
# Spoken answers to questions, read from the page Jev finished on. Same endpoint and key; defaults to TEXT_MODEL.
ANSWER_MODEL=google/gemini-3.8-flash
ANSWER_MODEL_REASONING=low
